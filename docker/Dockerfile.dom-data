FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-dom.txt /app/
RUN python -m pip install --no-cache-dir -r /app/requirements-dom.txt
COPY src /app/src
ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
USER 65532:65532
ENTRYPOINT ["python", "-m", "phishing_url.dom_dataset"]
