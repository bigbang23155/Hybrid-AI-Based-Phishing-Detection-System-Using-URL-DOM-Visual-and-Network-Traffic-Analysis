{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assignment02:label-review:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "policy_version",
    "reviewer_id",
    "reviewer_type",
    "reviewed_at",
    "source_assertion",
    "decision",
    "reason",
    "evidence"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "const": "label-policy-v1"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 2
    },
    "reviewer_type": {
      "enum": [
        "human",
        "automated"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_assertion": {
      "enum": [
        "assumed_benign",
        "source_reported_phishing"
      ]
    },
    "decision": {
      "enum": [
        "benign",
        "phishing",
        "uncertain",
        "exclude"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 20
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
